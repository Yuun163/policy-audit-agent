# DeepSeek大模型配置
DEEPSEEK_API_KEY=在这里填你的DeepSeek API Key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 飞书自建应用配置
FEISHU_APP_ID=在这里填你的飞书App ID
FEISHU_APP_SECRET=在这里填你的飞书App Secret

# 飞书多维表格配置
FEISHU_APP_TOKEN=在这里填多维表格Base的app_token（URL里“base/”后面，“?table”前面的那串）
BASE_INFO_TABLE_ID=在这里填企业基础信息表的table_id
FINANCIAL_TABLE_ID=在这里填企业研发与纳税信息表的table_id
AUDIT_TABLE_ID=在这里填企业财务审计表的table_id
